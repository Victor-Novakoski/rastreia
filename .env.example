# Copie para .env para rodar a API fora do Docker (make run).
DATABASE_URL=postgres://rastreia:rastreia@localhost:5432/rastreia?sslmode=disable
JWT_SECRET=dev-secret-change-me-at-least-32-chars
# Validade do access token. O refresh token (cookie) dura REFRESH_TTL sem uso.
JWT_TTL=15m
REFRESH_TTL=168h
PORT=8080
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@rastreia.dev
ADMIN_PASSWORD=admin12345
# Porta do Postgres no host usada pelo docker compose (mude se a 5432 estiver ocupada).
# Lembre de ajustar a porta em DATABASE_URL também.
DB_PORT=5432
# development ou production. Em production a API recusa os valores padrão acima.
APP_ENV=development
# Origens do front-end que podem chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
# Só ligue atrás de um proxy que define X-Forwarded-For (ex.: load balancer).
TRUST_PROXY=false
# Redis compartilha tempo real, rate limit e bloqueio de login entre instâncias da API.
# Vazio guarda tudo em memória, o que serve para uma instância só.
REDIS_URL=redis://localhost:6379/0
# Porta do Redis no host usada pelo docker compose (mude se a 6379 estiver ocupada).
REDIS_PORT=6379
# RabbitMQ recebe as mudanças de status para o worker mandar os e-mails.
# Vazio deixa os eventos guardados no banco até o RabbitMQ voltar.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_PORT=5672
# Worker (make run-worker). Em desenvolvimento os e-mails caem no Mailpit: http://localhost:8025
TRACKING_URL=http://localhost:5173/rastreio
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Rastreia <nao-responda@rastreia.dev>
# Em production o worker exige SMTP_TLS=true e TRACKING_URL com https.
SMTP_TLS=false
# Web Push (aviso no celular). Gere as chaves com: go run ./cmd/worker vapid
# A API usa só a pública; o worker usa as duas e o DATABASE_URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@rastreia.dev
