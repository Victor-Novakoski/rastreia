# Copie para .env. O docker compose lê DB_PORT daqui; o resto é usado quando a
# API roda fora do Docker (air ou make run).

# Porta do Postgres no seu PC. Se mudar, mude também em DATABASE_URL.
DB_PORT=5432
DATABASE_URL=postgres://rastreia:rastreia@localhost:5432/rastreia?sslmode=disable
JWT_SECRET=dev-secret-change-me-at-least-32-chars
JWT_TTL=24h
PORT=8080
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@rastreia.dev
ADMIN_PASSWORD=admin12345
# Porta do Postgres no host usada pelo docker compose (mude se a 5432 estiver ocupada).
# Lembre de ajustar a porta em DATABASE_URL também.
DB_PORT=5432
